<section id="gallery" class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4">
        <div class="reveal-on-scroll text-center max-w-3xl mx-auto mb-20 space-y-4">
            <p class="text-yellow-600 font-bold uppercase tracking-widest text-sm">Volunteering & Community Gallery</p>
            <h2 class="text-4xl md:text-5xl font-bold text-slate-900">Teaching, Interpreting & Advocacy in Action</h2>
            <p class="text-lg text-slate-600">
                A curated visual archive showing online lessons, classroom teaching, webinar song interpretations, legal court hearings, and volunteer activities within the Deaf community.
            </p>
        </div>

        <div class="space-y-24">
            @for (int i = 0; i < Model.GalleryItems.Count; i++)
            {
                var item = Model.GalleryItems[i];
                    var isReversed = i % 2 != 0;
                
                <div class="reveal-on-scroll flex flex-col md:flex-row items-center gap-12 @(isReversed ? "md:flex-row-reverse" : "")" style="transition-delay: @(Math.Min(i * 100, 300))ms;">
                    <div class="w-full md:w-1/2 relative group">
                        <div class="absolute -inset-4 bg-yellow-100 rounded-3xl group-hover:bg-yellow-200 transition-colors -z-10"></div>
                        <div class="relative rounded-2xl overflow-hidden shadow-xl border-4 border-white">
                            <img src="@item.Src" alt="@item.Alt" class="w-full h-auto block transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                        </div>
                    </div>

                    <div class="w-full md:w-1/2 space-y-4">
                        <h3 class="text-2xl font-bold text-slate-900 uppercase tracking-tight">@item.Title</h3>
                        <span class="inline-block px-3 py-1 rounded-full bg-yellow-100 text-yellow-700 text-xs font-bold uppercase">@item.Category</span>
                        <p class="text-lg text-slate-600 leading-relaxed">@item.Description</p>
                        <div class="flex flex-wrap gap-2 pt-2">
                            @foreach (var tag in item.Tags)
                            {
                                <span class="text-xs font-semibold text-slate-400 border border-slate-200 px-2 py-1 rounded-md">@tag</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
