@{
    Layout = null;
    var model = Model as TeacherPrecy.Models.HomeViewModel;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-white text-slate-900 antialiased">
    <!-- Navigation -->
    <header id="main-nav" class="fixed top-0 w-full z-50 transition-all duration-300 px-4 py-4">
        <div class="max-w-7xl mx-auto flex justify-between items-center bg-white/80 backdrop-blur-md rounded-full px-6 py-3 shadow-sm border border-slate-100">
            <a href="/" class="flex items-center gap-2 group">
                <img src="/public/image/Logo.png" alt="Logo" class="h-8 w-auto" />
                <span class="font-bold text-xl tracking-tight group-hover:text-yellow-600 transition-colors">Teacher Precy</span>
            </a>
            <nav class="hidden md:flex items-center gap-8 font-medium text-slate-600">
                <a href="/" class="hover:text-yellow-600 transition-colors">Home</a>
                <a href="#story" class="hover:text-yellow-600 transition-colors">Story</a>
                <a href="#gallery" class="hover:text-yellow-600 transition-colors">Gallery</a>
                <a href="/Academy" class="hover:text-yellow-600 transition-colors">Academy</a>
                <a href="/Booking" class="hover:text-yellow-600 transition-colors">Booking</a>
            </nav>
            <div class="flex items-center gap-4">
                <a href="/Login" class="bg-yellow-500 hover:bg-yellow-600 text-white px-5 py-2 rounded-full font-semibold transition-all shadow-md hover:shadow-lg">
                    Get in Touch
                </a>
            </div>
        </div>
    </header>

    <!-- Hero Section -->
    <section id="hero" class="relative pt-32 pb-20 overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class="reveal-on-scroll space-y-8">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-yellow-100 text-yellow-700 text-sm font-medium border border-yellow-200">
                    <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-yellow-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-yellow-500"></span>
                    </span>
                    <span>@(model?.Hero?.Kicker ?? "")</span>
                </div>
                
                <h1 class="text-5xl lg:text-7xl font-extrabold leading-tight tracking-tight">
                    Inclusive learning <span class="text-yellow-500">starts here.</span>
                </h1>
                
                <p class="text-lg text-slate-600 leading-relaxed max-w-2xl">
                    @(model?.Hero?.Mission ?? "")
                </p>
                
                <div class="flex flex-wrap gap-4">
                    <a href="/Book" class="bg-yellow-500 hover:bg-yellow-600 text-white px-8 py-4 rounded-full font-bold transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-1">
                        @(model?.Hero?.PrimaryCta ?? "")
                    </a>
                    <a href="/Academy" class="bg-white border-2 border-slate-200 hover:border-yellow-500 text-slate-700 px-8 py-4 rounded-full font-bold transition-all hover:bg-slate-50 transform hover:-translate-y-1">
                        @(model?.Hero?.SecondaryCta ?? "")
                    </a>
                </div>
                
                <div class="flex flex-wrap gap-6 pt-8 items-center text-slate-500 font-medium">
                    <span class="px-3 py-1 rounded-full bg-yellow-100 text-yellow-700 text-xs font-bold uppercase tracking-wider">Trusted FSL Coach</span>
                    <div class="flex items-center gap-1">
                        <span class="count-up text-slate-900 font-bold" data-value="7">+</span> years FSL practice
                    </div>
                    <div class="flex items-center gap-1">
                        <span class="count-up text-slate-900 font-bold" data-value="10">+</span> expertise areas
                    </div>
                    <div class="flex items-center gap-1">
                        <span class="count-up text-slate-900 font-bold" data-value="12">+</span> guided lessons
                    </div>
                </div>
            </div>
            
            <div class="relative reveal-on-scroll" style="transition-delay: 200ms;">
                <div class="relative z-10 rounded-3xl overflow-hidden shadow-2xl transform rotate-2 hover:rotate-0 transition-transform duration-500">
                    <img src="/public/image/Profile.png" alt="Precy Alarba" class="w-full h-auto" />
                </div>
                <div class="absolute -top-4 -right-4 w-full h-full bg-yellow-200 rounded-3xl -z-10 opacity-50"></div>
            </div>
        </div>
    </section>

    <!-- About Me (Story) Section -->
    <section id="story" class="py-24 bg-slate-50">
        <div class="max-w-4xl mx-auto px-4">
            <div class="reveal-on-scroll space-y-6 text-center mb-16">
                <p class="text-yellow-600 font-bold uppercase tracking-widest text-sm">@(model?.Story?.NarrativeLabel ?? "")</p>
                <h2 class="text-4xl md:text-5xl font-bold text-slate-900">@(model?.Story?.NarrativeHeadline ?? "")</h2>
                <p class="text-lg text-slate-600 leading-relaxed">
                    @(model?.Story?.NarrativeBody ?? "")
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="reveal-on-scroll p-8 bg-white rounded-3xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow" style="transition-delay: 100ms;">
                    <p class="text-yellow-600 font-bold uppercase tracking-widest text-xs mb-4">Professional Expertise</p>
                    <p class="text-slate-700 leading-relaxed font-medium">
                        @(model?.Story?.ProfessionalExpertise ?? "")
                    </p>
                </div>

                <div class="reveal-on-scroll p-8 bg-white rounded-3xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow" style="transition-delay: 200ms;">
                    <p class="text-yellow-600 font-bold uppercase tracking-widest text-xs mb-4">Skills & Expertise</p>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var skill in (model?.Story?.Expertise ?? new List<string>()))
                        {
                            <span class="px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-sm font-medium border border-slate-200">
                                @skill
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Gallery Section -->
    <section id="gallery" class="py-24 bg-white">
        <div class="max-w-7xl mx-auto px-4">
            <div class="reveal-on-scroll text-center max-w-3xl mx-auto mb-20 space-y-4">
                <p class="text-yellow-600 font-bold uppercase tracking-widest text-sm">Volunteering & Community Gallery</p>
                <h2 class="text-4xl md:text-5xl font-bold text-slate-900">Teaching, Interpreting & Advocacy in Action</h2>
                <p class="text-lg text-slate-600">
                    A curated visual archive showing online lessons, classroom teaching, webinar song interpretations, legal court hearings, and volunteer activities within the Deaf community.
                </p>
            </div>

            <div class="space-y-24">
                @for (int i = 0; i < (model?.GalleryItems?.Count ?? 0); i++)
                {
                    var item = model?.GalleryItems[i];
                    var isReversed = i % 2 != 0;
                    
                    <div class="reveal-on-scroll flex flex-col md:flex-row items-center gap-12 @(isReversed ? "md:flex-row-reverse" : "")" style="transition-delay: @(Math.Min(i * 100, 300))ms;">
                        <div class="w-full md:w-1/2 relative group">
                            <div class="absolute -inset-4 bg-yellow-100 rounded-3xl group-hover:bg-yellow-200 transition-colors -z-10"></div>
                            <div class="relative rounded-2xl overflow-hidden shadow-xl border-4 border-white">
                                <img src="@(item?.Src ?? "")" alt="@(item?.Alt ?? "")" class="w-full h-auto block transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                            </div>
                        </div>

                        <div class="w-full md:w-1/2 space-y-4">
                            <h3 class="text-2xl font-bold text-slate-900 uppercase tracking-tight">@(item?.Title ?? "")</h3>
                            <span class="inline-block px-3 py-1 rounded-full bg-yellow-100 text-yellow-700 text-xs font-bold uppercase">@(item?.Category ?? "")</span>
                            <p class="text-lg text-slate-600 leading-relaxed">@(item?.Description ?? "")</p>
                            <div class="flex flex-wrap gap-2 pt-2">
                                @foreach (var tag in (item?.Tags ?? new List<string>()))
                                {
                                    <span class="text-xs font-semibold text-slate-400 border border-slate-200 px-2 py-1 rounded-md">@tag</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- Social Proof Section -->
    <section class="py-24 bg-slate-50 overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 mb-16">
            <div class="reveal-on-scroll text-center space-y-4">
                <p class="text-yellow-600 font-bold uppercase tracking-widest text-sm">Social Proof / Excerpts</p>
                <h2 class="text-4xl md:text-5xl font-bold text-slate-900">Notes from learners who needed clarity.</h2>
            </div>
        </div>

        <div class="relative pause-marquee">
            <div class="flex overflow-hidden">
                <div class="animate-marquee flex gap-6 whitespace-nowrap py-4 px-4">
                    @for (int i = 0; i < 4; i++) 
                    {
                        @foreach (var item in (model?.SocialProofs ?? new List<TeacherPrecy.Models.SocialProofItem>()))
                        {
                            <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm flex flex-col gap-4 min-w-[350px] max-w-[350px]">
                                <div class="text-yellow-500 opacity-30">
                                    <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M11 7.5H7.5C5.57 7.5 4 9.07 4 11v1.5C4 14.43 5.57 16 7.5 16S11 14.43 11 12.5V7.5z" />
                                        <path d="M20 7.5h-3.5C14.57 7.5 13 9.07 13 11v1.5c0 1.93 1.57 3.5 3.5 3.5S20 14.43 20 12.5V7.5z" />
                                    </svg>
                                </div>
                                <blockquote class="text-slate-600 italic leading-relaxed">
                                    "@(item?.Quote ?? "")"
                                </blockquote>
                                <div class="flex items-center gap-3">
                                    <div class="h-8 w-8 rounded-full bg-yellow-500 text-white flex items-center justify-center font-bold text-xs uppercase">
                                        @(item?.Source?.Substring(0, 1) ?? "")
                                    </div>
                                    <cite class="text-sm font-bold text-slate-900 not-italic">@(item?.Source ?? "")</cite>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </section>


    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400 py-12 border-t border-slate-800">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <p>&copy; @DateTime.Now.Year Teacher Precy. All rights reserved.</p>
        </div>
    </footer>

    <script>
        // Intersection Observer for Reveal-on-Scroll
        const revealObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                }
            });
        }, { threshold: 0.15 });

        document.querySelectorAll('.reveal-on-scroll').forEach(el => revealObserver.observe(el));

        // CountUp Animation logic
        const countUpObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const target = entry.target;
                    const value = parseInt(target.dataset.value);
                    const duration = 1500;
                    const startTime = performance.now();

                    const tick = (now) => {
                        const progress = Math.min((now - startTime) / duration, 1);
                        const eased = 1 - Math.pow(1 - progress, 3);
                        target.innerText = Math.round(value * eased) + (target.innerText.includes('+') ? '+' : '');
                        if (progress < 1) requestAnimationFrame(tick);
                    };
                    requestAnimationFrame(tick);
                    countUpObserver.unobserve(target);
                }
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.count-up').forEach(el => countUpObserver.observe(el));

        // Nav scroll effect
        window.addEventListener('scroll', () => {
            const nav = document.getElementById('main-nav');
            if (window.scrollY > 20) {
                nav.classList.add('py-2');
                nav.classList.remove('py-4');
            } else {
                nav.classList.add('py-4');
                nav.classList.remove('py-2');
            }
        });
    </script>
</body>
</html>
